pipeline {
    agent any
    tools {
        maven 'maven-spring'
        jdk 'jdk-spring'
    }
    environment {
        PROJECT_NAME = "E-commerce-project-springBoot"
        GITHUB_REPO_URL = "https://github.com/paayalkhandelwal01/E-commerce-project-springBoot.git"
    }

    stages {          
        stage('Build') {
            steps {
                dir('JtProject') {
                    sh 'mvn clean package'
                }
            }
        }
        
        stage('Test') {
            steps {
                dir('JtProject') {
                    sh 'mvn test'
                }
            }
        }
        
        stage('Deploy') {
            environment {
                DB_USER = credentials('mysql-username')
                DB_PASS = credentials('mysql-password')
            }
            steps {
                sh '''
                # Stop and remove old containers
                docker compose -f docker-compose.yml down || true

                # Build and start new containers with secrets
                DB_USER=$DB_USER DB_PASS=$DB_PASS docker compose -f docker-compose.yml up -d --build
                '''
            }
        }
    }

    post {
        always {
            cleanWs()
        }
        success {
            echo 'Pipeline succeeded!'
        }
        failure {
            echo 'Pipeline failed!'
        }
    }
}
