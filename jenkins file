pipeline {
    agent any
    tools {
        maven 'maven-spring'
        jdk 'jdk-spring'
    }
    environment {
        PROJECT_NAME = "E-commerce-project-springBoot"
        GITHUB_REPO_URL = "https://github.com/paayalkhandelwal01/E-commerce-project-springBoot.git"
    }

    stages {
        stage('Checkout') {
            steps {
                git url: "${GITHUB_REPO_URL}", branch: 'master2'
            }
        }
        
        stage('Build') {
            steps {
                sh 'mvn clean package'
            }
        }
        
        stage('Test') {
            steps {
                sh 'mvn test'
            }
        }
        
        stage('Deploy') {
            steps {
                sh '''
                    # 1. Install MySQL client if not installed
                    sudo apt-get update
                    sudo apt-get install -y mysql-client

                    # 2. Create database (only if not exists)
                    mysql -u root -p project#01 -e "CREATE DATABASE IF NOT EXISTS ecommjava;"

                    # 3. Run schema.sql if you have one
                    mysql -u root -p project#01 ecommjava < database/schema.sql

                    # 4. Deploy the app (example: run Spring Boot JAR)
                    nohup java -jar target/ecommjava-1.0.jar &
                '''
            }
        }
    }
    
    post {
        always {
            cleanWs()
        }
        success {
            echo 'Pipeline succeeded!'
        }
        failure {
            echo 'Pipeline failed!'
        }
    }
}

